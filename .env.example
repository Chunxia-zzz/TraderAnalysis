# TraderAnalysis 环境变量示例
# 复制此文件为 .env，按需修改（.env 已在 .gitignore 中，不会提交）

# ── 数据源 ──────────────────────────────────────────────────────────────────
# 数据文件路径（支持 .json Futu K 线格式 或 .csv）
TA_DATA_PATH=examples/mock_futu_kline_HK.00700.json

# 标的代码（如 HK.00700、US.AAPL）
TA_SYMBOL=HK.00700

# K 线周期（1D / 60M / 15M 等）
TA_TIMEFRAME=1D

# ── 策略 ────────────────────────────────────────────────────────────────────
# 使用的策略名称：ma_cross | rsi_reversal
TA_STRATEGY=ma_cross

# 数据刷新间隔（秒）
TA_REFRESH_SECONDS=5

# ── 服务器 ──────────────────────────────────────────────────────────────────
# 监听地址（云服务器部署时设为 0.0.0.0）
# TA_HOST=0.0.0.0
# TA_PORT=8000

# ── 富途 OpenD（接入真实行情时填写）────────────────────────────────────────
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
