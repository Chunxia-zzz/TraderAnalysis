# TraderAnalysis 环境变量示例
# 复制此文件为 .env，按需修改（.env 已在 .gitignore 中，不会提交）

# ── 存储 ────────────────────────────────────────────────────────────────────
# SQLite 数据库路径（默认 data/indicators.db）
# TA_DB_PATH=data/indicators.db

# 日志目录（默认 logs/）
# TA_LOG_DIR=logs

# ── 服务器 ──────────────────────────────────────────────────────────────────
# 监听地址（云服务器部署时设为 0.0.0.0）
# TA_HOST=0.0.0.0
# TA_PORT=8000

# ── 富途 OpenD ──────────────────────────────────────────────────────────────
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111

# ── HTTP 代理（国内访问 CNN F&G 可能需要）──────────────────────────────────
# HTTP_PROXIES=http://127.0.0.1:7890

# ── 认证 (JWT) ────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须设置，可用以下命令生成）
# python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=your-random-secret-here

# Token 有效期天数（默认 7 天）
# JWT_EXPIRE_DAYS=7

# ── Docker 部署 ───────────────────────────────────────────────────────────
# 时区（定时任务依赖此设置）
# TZ=Asia/Shanghai
