# TraderAnalysis 环境变量示例
#
# 注意两点（与代码逐一核对过）：
# 1. 项目不自动加载 .env 文件（未依赖 python-dotenv）——变量必须是真实进程环境变量：
#    shell 里 export、CI 的 env:、或 systemd 的 Environment=。
# 2. 下面只列代码实际读取的变量。serve 的 host/port 是 CLI 参数
#    （`trader-analysis serve --host 0.0.0.0 --port 8000`），OpenD 地址是
#    config.py 常量（127.0.0.1:11111），都**不支持**环境变量覆盖。

# ── 存储 ────────────────────────────────────────────────────────────────────
# SQLite 数据库路径（默认 data/indicators.db）
# TA_DB_PATH=data/indicators.db

# 日志目录（默认 logs/）
# TA_LOG_DIR=logs

# ── 数据口径 ────────────────────────────────────────────────────────────────
# 允许写入当天尚未收盘的 K 线（默认 0：只落已收盘 K 线，半截 K 线永不覆盖）
# TA_ALLOW_PARTIAL_BAR=0
